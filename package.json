{
  "name": "faithfinder-mcp-server",
  "version": "2.0.0",
  "mcpName": "io.github.ArmorNGlory/faithfinder-mcp-server",
  "description": "Find a church near you from any AI assistant. MCP server for FaithFinder: search 9,000+ US Christian churches by city, ZIP, denomination, worship style and kids ministry, with beliefs, sermons and reviews.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "faithfinder-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "openai-action.json",
    "server.json"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsc && node dist/index.js",
    "build:web": "tsc && node scripts/build-web-kit.mjs",
    "prepublishOnly": "npm run build",
    "indexnow": "node scripts/indexnow-submit.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "church",
    "church-finder",
    "find-a-church",
    "church-near-me",
    "church-search",
    "church-directory",
    "christian",
    "christianity",
    "faith",
    "denomination",
    "worship",
    "sermons",
    "kids-ministry",
    "local-search",
    "faithfinder",
    "chatgpt",
    "claude",
    "gemini",
    "ai-agent",
    "llm"
  ],
  "homepage": "https://faithfinder.armornglory.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArmorNGlory/faithfinder-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/ArmorNGlory/faithfinder-mcp-server/issues"
  },
  "author": "ArmorNGlory",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
